{
  "name": "hangram",
  "productName": "Hangram",
  "version": "0.1.0",
  "description": "Launcher and vault for multiple Telegram Desktop accounts",
  "private": true,
  "main": "out/main/index.js",
  "author": "wrallin",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "native": "node scripts/build-native.mjs",
    "fetch-telegram": "tsx scripts/fetch-telegram.ts",
    "postinstall": "node scripts/build-native.mjs",
    "dist": "npm run build && npm run native && npm run fetch-telegram && electron-builder",
    "dist:lite": "npm run build && npm run native && electron-builder"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "teleproto": "^1.229.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
